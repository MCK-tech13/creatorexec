# Supabase (Phase 1 — do not commit real values)
#
# Where to find these in Supabase Dashboard:
# 1. Open https://supabase.com/dashboard and select your project
# 2. Go to Settings (gear icon) → API
# 3. Project URL → copy into SUPABASE_URL / VITE_SUPABASE_URL
# 4. Project API keys → anon public → VITE_SUPABASE_ANON_KEY / SUPABASE_ANON_KEY
# 5. Project API keys → service_role (secret) → SUPABASE_SERVICE_ROLE_KEY (tests/scripts only)
#
# VITE_* vars are exposed to the browser in Phase 2 — never put service_role in VITE_ vars.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe (billing — test mode first)
#
# Stripe Dashboard → Developers → API keys (Test mode ON)
# Secret key → STRIPE_SECRET_KEY
# Product catalog → $25/month beta price → Price ID → STRIPE_BETA_PRICE_ID
#
# Local webhooks: stripe listen --forward-to localhost:4242/api/stripe/webhook
# Copy printed whsec_... → STRIPE_WEBHOOK_SECRET (restart npm run dev:api after setting)

STRIPE_SECRET_KEY=
STRIPE_BETA_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# Resend — welcome email after checkout.session.completed + upload reminder cron
# Resend Dashboard → API Keys → create key → RESEND_API_KEY
RESEND_API_KEY=

# Vercel Cron auth for /api/cron/upload-reminder
# Generate a long random string and set the same value in Vercel env as CRON_SECRET.
# Vercel sends Authorization: Bearer <CRON_SECRET> on scheduled invocations.
CRON_SECRET=

# Anthropic — Product Scout screenshot OCR (server-only, never VITE_)
# Anthropic Console → API Keys → ANTHROPIC_API_KEY
# Used by POST /api/product-scout/extract-screenshot (claude-sonnet-4-6 vision)
ANTHROPIC_API_KEY=

# TikTok Login Kit (Connect TikTok — App Review / video attribution later)
# TikTok Developer Portal → your app → Login Kit (Web)
# Client Key → TIKTOK_CLIENT_KEY
# Client Secret → TIKTOK_CLIENT_SECRET
# Redirect URI must match exactly (Production demo):
#   https://www.creatorexec.app/api/tiktok/oauth/callback
# Optional override: TIKTOK_REDIRECT_URI=
# OAuth state HMAC secret (or reuse CRON_SECRET):
# TIKTOK_OAUTH_STATE_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# TIKTOK_REDIRECT_URI=https://www.creatorexec.app/api/tiktok/oauth/callback
# TIKTOK_OAUTH_STATE_SECRET=

# Optional JSON map for additional Stripe price IDs → display names
# (STRIPE_BETA_PRICE_ID is auto-labeled "Beta — Monthly" if not listed here)
# STRIPE_PRICE_DISPLAY_NAMES={"price_xxx":"CreatorExec — Monthly","price_yyy":"CreatorExec — Yearly"}

# App URL for Stripe Checkout success/cancel redirects and Customer Portal return URL
APP_URL=http://localhost:5173
STRIPE_API_PORT=4242

# Optional — only needed if you add Stripe Elements later
VITE_STRIPE_PUBLISHABLE_KEY=

# ---------------------------------------------------------------------------
# Production (Vercel) — see docs/DEPLOYMENT.md
# ---------------------------------------------------------------------------
# Frontend (client-safe, VITE_ prefix):
#   VITE_SUPABASE_URL, VITE_SUPABASE_ANON_KEY
#
# API server (same Vercel project, NO VITE_ prefix):
#   SUPABASE_URL, SUPABASE_ANON_KEY, SUPABASE_SERVICE_ROLE_KEY
#   STRIPE_SECRET_KEY, STRIPE_BETA_PRICE_ID, STRIPE_WEBHOOK_SECRET
#   RESEND_API_KEY
#   ANTHROPIC_API_KEY
#   TIKTOK_CLIENT_KEY, TIKTOK_CLIENT_SECRET
#   (optional) TIKTOK_REDIRECT_URI, TIKTOK_OAUTH_STATE_SECRET
#   APP_URL=https://www.creatorexec.app
#
# Production Stripe webhook URL:
#   https://creatorexec.app/api/stripe/webhook
#
# TikTok OAuth callback (must match Developer Portal):
#   https://www.creatorexec.app/api/tiktok/oauth/callback
