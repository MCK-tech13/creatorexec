# Supabase (Phase 1 — do not commit real values)
#
# Where to find these in Supabase Dashboard:
# 1. Open https://supabase.com/dashboard and select your project
# 2. Go to Settings (gear icon) → API
# 3. Project URL → copy into SUPABASE_URL / VITE_SUPABASE_URL
# 4. Project API keys → anon public → VITE_SUPABASE_ANON_KEY / SUPABASE_ANON_KEY
# 5. Project API keys → service_role (secret) → SUPABASE_SERVICE_ROLE_KEY (tests/scripts only)
#
# VITE_* vars are exposed to the browser in Phase 2 — never put service_role in VITE_ vars.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe (billing — test mode first)
#
# Stripe Dashboard → Developers → API keys (Test mode ON)
# Secret key → STRIPE_SECRET_KEY
# Product catalog → $25/month beta price → Price ID → STRIPE_BETA_PRICE_ID
#
# Local webhooks: stripe listen --forward-to localhost:4242/api/stripe/webhook
# Copy printed whsec_... → STRIPE_WEBHOOK_SECRET (restart npm run dev:api after setting)

STRIPE_SECRET_KEY=
STRIPE_BETA_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# App URL for Stripe Checkout success/cancel redirects and Customer Portal return URL
APP_URL=http://localhost:5173
STRIPE_API_PORT=4242

# Optional — only needed if you add Stripe Elements later
VITE_STRIPE_PUBLISHABLE_KEY=
